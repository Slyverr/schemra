visual traffic_overview "Service traffic" {
  direction: left-to-right

  group clients "Clients" {
    layout: grid
    columns: 2

    node user_1 "User 1" {
      icon: "user"
      detail: "Sends requests"
    }
    node user_2 "User 2" {
      icon: "user"
      detail: "Sends requests"
    }
    node user_3 "User 3" {
      icon: "user"
      detail: "Sends requests"
    }
    node user_4 "User 4" {
      icon: "user"
      detail: "Sends requests"
    }
  }

  group application "Application" {
    layout: auto

    node reverse_proxy "Reverse proxy" {
      icon: "server"
      detail: "Routes requests"
    }
    node backend "Backend service" {
      icon: "server"
      detail: "Processes requests"
    }
  }

  group data "Data" {
    node audit_worker "Audit worker" {
      icon: "server"
      detail: "Writes audit records"
    }
    node database "Database" {
      icon: "database"
      detail: "Stores application data"
    }
  }

  user_1 -- reverse_proxy
  user_2 -- reverse_proxy
  user_3 -- reverse_proxy
  user_4 -- reverse_proxy
  reverse_proxy -- backend
  backend -- database
  audit_worker -> database
}
